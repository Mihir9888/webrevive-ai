# WebRevive AI Environment Variables Configuration

PROJECT_NAME="WebRevive AI"
DEBUG=True
API_V1_STR="/api"

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webrevive

# Local LLM (Ollama) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=90.0

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Headless Browser
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT_MS=45000
